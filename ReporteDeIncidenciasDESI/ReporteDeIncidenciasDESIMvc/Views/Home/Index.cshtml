@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestión de Incidencias - H. Ayuntamiento de Poza Rica</title>

    <!-- Bootstrap 3 CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/CSS/Template/HomeIndex.css" rel="stylesheet" />

</head>
<body>
    <!-- Header institucional -->
    <header class="header-institucional">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-12 col-sm-8">
                    <div class="row">
                        <div class="col-xs-3 col-sm-2">
                            <img src="https://i0.wp.com/poza-rica.gob.mx/wp-content/uploads/2025/12/logo-web-poza-rica-2026-2029.png?fit=1180%2C313&ssl=1"
                                 alt="Logo Gobierno de Poza Rica" class="logo-img img-responsive">
                        </div>
                        <div class="col-xs-9 col-sm-10">
                            <div class="texto-institucional">
                                <h1>GOBIERNO DE POZA RICA</h1>
                                <p>H. Ayuntamiento 2026-2029 • La esperanza hecha gobierno</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4">
                    <div class="info-sistema hidden-xs">
                        <p><strong>Sistema de Gestión de Incidencias Ciudadanas</strong></p>
                        <p>Versión 2.1 • Última actualización: 18/01/2026</p>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Barra de navegación con Bootstrap -->
    <nav class="navbar navbar-institucional">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-principal" aria-expanded="false">
                    <span class="sr-only">Mostrar navegación</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand hidden-sm hidden-md hidden-lg" href="#">
                    <i class="fas fa-bars"></i> Menú
                </a>
                <div class="visible-xs-block usuario-sesion-movil">
                    <span class="hidden-sm hidden-md hidden-lg"><i class="fas fa-user-shield"></i> Depto. Servicios Públicos</span>
                </div>
            </div>

            <div class="collapse navbar-collapse" id="navbar-principal">
                <ul class="nav navbar-nav">
                    <li class="active"><a href="#"><i class="fas fa-home"></i> Inicio</a></li>
                    <li><a href="#"><i class="fas fa-plus-circle"></i> Nueva Incidencia</a></li>
                    <li><a href="#"><i class="fas fa-map-marked-alt"></i> Mapa</a></li>
                    <li><a href="#"><i class="fas fa-chart-line"></i> Reportes</a></li>
                    <li><a href="#"><i class="fas fa-users-cog"></i> Administración</a></li>
                    <li><a href="#"><i class="fas fa-cog"></i> Configuración</a></li>
                </ul>

                <div class="navbar-right hidden-xs">
                    <div class="usuario-sesion">
                        <span><i class="fas fa-user-shield"></i> Departamento de Servicios Públicos</span>
                        <button class="btn btn-sesion btn-xs"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <main class="container-fluid">
        <div class="row">
            <div class="col-xs-12">
                <!-- Encabezado de página -->
                <div class="encabezado-pagina">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6">
                            <h1 class="titulo-pagina"><i class="fas fa-clipboard-list"></i> Panel de Control de Incidencias</h1>
                        </div>
                        <div class="col-xs-12 col-sm-6 text-right">
                            <button class="btn btn-accion-principal">
                                <i class="fas fa-plus"></i> Reportar Nueva Incidencia
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tarjetas de estadísticas -->
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="tarjeta-estadistica">
                            <div class="numero-estadistica">156</div>
                            <p>Total de Incidencias</p>
                            <small>Registradas este mes</small>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="tarjeta-estadistica tarjeta-urgente">
                            <div class="numero-estadistica">23</div>
                            <p>Incidencias Urgentes</p>
                            <small>Requieren atención inmediata</small>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="tarjeta-estadistica tarjeta-proceso">
                            <div class="numero-estadistica">89</div>
                            <p>En Proceso</p>
                            <small>En atención actualmente</small>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-3">
                        <div class="tarjeta-estadistica tarjeta-resuelto">
                            <div class="numero-estadistica">44</div>
                            <p>Resueltas</p>
                            <small>Cerradas satisfactoriamente</small>
                        </div>
                    </div>
                </div>

                <!-- Panel de filtros -->
                <div class="panel panel-filtros">
                    <div class="panel-heading panel-heading-filtros">
                        <h3 class="panel-title"><i class="fas fa-filter"></i> Filtros de Búsqueda</h3>
                    </div>
                    <div class="panel-body panel-body-filtros">
                        <form class="form-horizontal">
                            <div class="row">
                                <div class="col-xs-12 col-sm-4">
                                    <div class="form-group">
                                        <label for="categoria" class="control-label"><i class="fas fa-tags"></i> Categoría</label>
                                        <select id="categoria" class="form-control">
                                            <option value="">Todas las categorías</option>
                                            <option>Alumbrado Público</option>
                                            <option>Bacheo y Pavimentación</option>
                                            <option>Recolección de Basura</option>
                                            <option>Agua Potable y Drenaje</option>
                                            <option>Parques y Jardines</option>
                                            <option>Tránsito y Vialidad</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4">
                                    <div class="form-group">
                                        <label for="estado" class="control-label"><i class="fas fa-flag"></i> Estado</label>
                                        <select id="estado" class="form-control">
                                            <option value="">Todos los estados</option>
                                            <option>Reportado</option>
                                            <option>En verificación</option>
                                            <option>En proceso</option>
                                            <option>Resuelto</option>
                                            <option>Cerrado</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4">
                                    <div class="form-group">
                                        <label for="fecha" class="control-label"><i class="fas fa-calendar-alt"></i> Fecha de Reporte</label>
                                        <input type="date" id="fecha" class="form-control">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-12 text-right">
                                    <button type="button" class="btn btn-filtro-primario">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <button type="button" class="btn btn-filtro-secundario">
                                        <i class="fas fa-redo"></i> Limpiar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Tabla de incidencias -->
                <div class="panel panel-tabla">
                    <div class="panel-heading panel-heading-tabla">
                        <h3 class="panel-title"><i class="fas fa-list"></i> Incidencias Recientes</h3>
                    </div>
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="table tabla-incidencias">
                                <thead>
                                    <tr>
                                        <th>ID Incidencia</th>
                                        <th>Fecha Reporte</th>
                                        <th>Descripción</th>
                                        <th>Categoría</th>
                                        <th>Ubicación</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>#PR-2026-00158</strong></td>
                                        <td>18/01/2026<br><small>15:42 hrs</small></td>
                                        <td>Lámpara fundida en cruce de Av. Juárez y Calle 5</td>
                                        <td>Alumbrado Público</td>
                                        <td>Col. Centro, Av. Juárez</td>
                                        <td><span class="etiqueta-estado etiqueta-urgente">URGENTE</span></td>
                                        <td class="hidden-xs">
                                            <button class="btn btn-accion-tabla btn-xs" title="Ver detalles"><i class="fas fa-eye"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Asignar"><i class="fas fa-user-check"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Actualizar"><i class="fas fa-edit"></i></button>
                                        </td>
                                        <td class="visible-xs-block celda-acciones-movil">
                                            <button class="btn btn-accion-tabla btn-xs" title="Ver detalles"><i class="fas fa-eye"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Asignar"><i class="fas fa-user-check"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Actualizar"><i class="fas fa-edit"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>#PR-2026-00157</strong></td>
                                        <td>17/01/2026<br><small>10:18 hrs</small></td>
                                        <td>Bache considerable en Av. 20 de Noviembre</td>
                                        <td>Bacheo y Pavimentación</td>
                                        <td>Fracc. Petrolero</td>
                                        <td><span class="etiqueta-estado etiqueta-proceso">EN PROCESO</span></td>
                                        <td class="hidden-xs">
                                            <button class="btn btn-accion-tabla btn-xs" title="Ver detalles"><i class="fas fa-eye"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Asignar"><i class="fas fa-user-check"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Actualizar"><i class="fas fa-edit"></i></button>
                                        </td>
                                        <td class="visible-xs-block celda-acciones-movil">
                                            <button class="btn btn-accion-tabla btn-xs" title="Ver detalles"><i class="fas fa-eye"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Asignar"><i class="fas fa-user-check"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Actualizar"><i class="fas fa-edit"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>#PR-2026-00142</strong></td>
                                        <td>15/01/2026<br><small>08:30 hrs</small></td>
                                        <td>Fuga de agua potable en Calle 5 de Mayo</td>
                                        <td>Agua Potable y Drenaje</td>
                                        <td>Col. Obrera</td>
                                        <td><span class="etiqueta-estado etiqueta-resuelto">RESUELTO</span></td>
                                        <td class="hidden-xs">
                                            <button class="btn btn-accion-tabla btn-xs" title="Ver detalles"><i class="fas fa-eye"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Asignar"><i class="fas fa-user-check"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Actualizar"><i class="fas fa-edit"></i></button>
                                        </td>
                                        <td class="visible-xs-block celda-acciones-movil">
                                            <button class="btn btn-accion-tabla btn-xs" title="Ver detalles"><i class="fas fa-eye"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Asignar"><i class="fas fa-user-check"></i></button>
                                            <button class="btn btn-accion-tabla btn-xs" title="Actualizar"><i class="fas fa-edit"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer institucional -->
    <footer class="footer-institucional">
        <div class="container">
            <div class="row">
                <div class="col-xs-12">
                    <img src="https://i0.wp.com/poza-rica.gob.mx/wp-content/uploads/2025/12/logo-web-poza-rica-2026-2029.png?fit=1180%2C313&ssl=1"
                         alt="Logo Gobierno de Poza Rica" class="logo-footer center-block">
                    <p class="text-center">© 2026 H. Ayuntamiento de Poza Rica de Hidalgo, Veracruz. Todos los derechos reservados.</p>
                    <p class="text-center">Este sistema es de uso exclusivo para la administración municipal de incidencias ciudadanas.</p>
                    <p class="text-center"><i class="fas fa-shield-alt"></i> Sistema certificado ISO 27001:2022 - Seguridad de la información</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 3 JavaScript -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="~/JS/Template/HomeIndex.js"></script>

</body>
</html>